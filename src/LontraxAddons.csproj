<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lontrax Addons</AssemblyName>
    <RootNamespace>LontraxAddons</RootNamespace>
    <ApplicationIcon>..\assets\brasao.ico</ApplicationIcon>
    <Version>1.0.8</Version>
    <Product>Lontrax Addons</Product>
    <Company>Lontrax</Company>
    <Description>Instala e atualiza os addons da galera Lontrax</Description>
    <!-- One .exe that runs on any Windows 10/11 PC, no .NET install needed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\index.html" LogicalName="ui.index.html" />
    <EmbeddedResource Include="ui\app.css" LogicalName="ui.app.css" />
    <EmbeddedResource Include="ui\app.js" LogicalName="ui.app.js" />
    <EmbeddedResource Include="..\assets\brasao.png" LogicalName="ui.brasao.png" />
    <EmbeddedResource Include="..\assets\brasao.ico" LogicalName="ui.brasao.ico" />
    <EmbeddedResource Include="ui\lontrinha-*.png" LogicalName="ui.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
